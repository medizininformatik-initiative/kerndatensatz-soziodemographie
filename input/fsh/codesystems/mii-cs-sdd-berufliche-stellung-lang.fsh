* #A "Selbstständige:r Landwirt:in oder Genossenschaftsbauer"
* #A ^designation[+].language = #en
* #A ^designation[=].value = "self-employed farmer or member of an agricultural cooperative"
* #B "Akademiker:in in freiem Beruf (Arzt/Ärztin, Rechtsanwalt/Rechtsanwältin, Steuerberater:in o. ä.)"
* #B ^designation[+].language = #en
* #B ^designation[=].value = "academic in a liberal profession (physician, lawyer, tax consultant or similar)"
* #C "Selbstständig im Handel, im Gastgewerbe, im Handwerk, in der Industrie, in der Dienstleistung, auch Ich-AG oder Mitglied einer Produktionsgenossenschaft des Handwerks (PGH) in der DDR"
* #C ^designation[+].language = #en
* #C ^designation[=].value = "self-employed in trade, hospitality, crafts, industry or services, including one-person business (Ich-AG) or member of a crafts production cooperative (PGH) in the GDR"
* #D "Beamter/Beamtin, Richter:in, Berufssoldat:in"
* #D ^designation[+].language = #en
* #D ^designation[=].value = "civil servant, judge, career soldier"
* #E "Angestellte:r (Angestellte sind Beschäftigte mit überwiegend geistiger Arbeit/Bürotätigkeiten)"
* #E ^designation[+].language = #en
* #E ^designation[=].value = "salaried employee (employees performing predominantly intellectual work/office work)"
* #F "Arbeiter:in (Arbeiter verrichten mehrheitlich körperliche Arbeit)"
* #F ^designation[+].language = #en
* #F ^designation[=].value = "worker (workers performing predominantly manual work)"
* #G "in einer beruflichen Ausbildung/Lehre"
* #G ^designation[+].language = #en
* #G ^designation[=].value = "in vocational training/apprenticeship"
* #H "mithelfende:r Familienangehörige:r"
* #H ^designation[+].language = #en
* #H ^designation[=].value = "contributing family member"

