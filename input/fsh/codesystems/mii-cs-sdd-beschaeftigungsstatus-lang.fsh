* insert Publisher
* insert PR_CS_VS_Version
* #A "Besuch einer allgemeinbildenden Schule, Studium, Berufliche Ausbildung, Umschulung"
* #A ^designation[+].language = #en
* #A ^designation[=].value = "attending a general education school, studies, vocational training, retraining"
* #B "freiwilliger Wehrdienst, Bundesfreiwilligendienst, freiwilliges soziales oder ökologisches Jahr"
* #B ^designation[+].language = #en
* #B ^designation[=].value = "voluntary military service, federal volunteer service, voluntary social or ecological year"
* #C "Erwerbsunterbrechung wegen Pflegezeit, Mutterschutz, Elternzeit ohne berufliche Tätigkeit"
* #C ^designation[+].language = #en
* #C ^designation[=].value = "career break due to care leave, maternity protection or parental leave without employment"
* #D "vollzeiterwerbstätig gemäß den branchenüblichen oder betrieblichen Regeln"
* #D ^designation[+].language = #en
* #D ^designation[=].value = "employed full-time according to industry or company standards"
* #E "teilzeiterwerbstätig, auch Midijob, aber mehr als ein Minijob"
* #E ^designation[+].language = #en
* #E ^designation[=].value = "employed part-time, including midijob, but more than a minijob"
* #F "in einer geringfügigen, gelegentlichen, kurzfristigen oder unregelmäßigen Beschäftigung (z. B. 538-Euro-Job, Minijob, Ein-Euro-Job, Saisonarbeit)"
* #F ^designation[+].language = #en
* #F ^designation[=].value = "in marginal, occasional, short-term or irregular employment (e.g. 538-euro job, minijob, one-euro job, seasonal work)"
* #G "Rentner:in, Pensionär:in"
* #G ^designation[+].language = #en
* #G ^designation[=].value = "retiree, pensioner"
* #H "arbeitslos"
* #H ^designation[+].language = #en
* #H ^designation[=].value = "unemployed"
* #I "dauerhaft erwerbsunfähig"
* #I ^designation[+].language = #en
* #I ^designation[=].value = "permanently unable to work"
* #J "langzeit krankgemeldet (z. B. länger als 6 Wochen krankgeschrieben, Erwerbsunterbrechung wegen Erkrankung, Bezug von Krankengeld o. ä.)"
* #J ^designation[+].language = #en
* #J ^designation[=].value = "on long-term sick leave (e.g. on sick leave for more than 6 weeks, career break due to illness, receiving sickness benefit or similar)"
* #K "Hausfrau/Hausmann"
* #K ^designation[+].language = #en
* #K ^designation[=].value = "homemaker"
* #L "sonstiges, und zwar"
* #L ^designation[+].language = #en
* #L ^designation[=].value = "other, namely"

