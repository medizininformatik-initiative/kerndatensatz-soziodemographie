* #B "von der Schule abgegangen ohne Schulabschluss"
* #B ^designation[+].language = #en
* #B ^designation[=].value = "left school without a school-leaving qualification"
* #C "Hauptschulabschluss, Volksschulabschluss oder vergleichbarer Abschluss"
* #C ^designation[+].language = #en
* #C ^designation[=].value = "lower secondary school leaving certificate (Hauptschulabschluss, Volksschulabschluss) or equivalent"
* #D "Polytechnische Oberschule der DDR mit Abschluss der 8. oder 9. Klasse"
* #D ^designation[+].language = #en
* #D ^designation[=].value = "polytechnic secondary school of the GDR, completed 8th or 9th grade"
* #E "Realschulabschluss, Mittlere Reife oder vergleichbarer Abschluss"
* #E ^designation[+].language = #en
* #E ^designation[=].value = "intermediate school leaving certificate (Realschulabschluss, Mittlere Reife) or equivalent"
* #F "Polytechnische Oberschule der DDR mit Abschluss der 10. Klasse"
* #F ^designation[+].language = #en
* #F ^designation[=].value = "polytechnic secondary school of the GDR, completed 10th grade"
* #G "Fachhochschulreife"
* #G ^designation[+].language = #en
* #G ^designation[=].value = "entrance qualification for universities of applied sciences (Fachhochschulreife)"
* #H "Abitur, Allgemeine/ Fachgebundene Hochschulreife, Gymnasium bzw. Erweiterte Oberschule (EOS), auch EOS mit Lehre"
* #H ^designation[+].language = #en
* #H ^designation[=].value = "general or subject-specific higher education entrance qualification (Abitur), Gymnasium or extended secondary school of the GDR (EOS), including EOS with vocational training"
